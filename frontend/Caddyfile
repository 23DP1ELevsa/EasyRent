{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Real-IP
	}
}

# Railway terminates HTTPS and forwards HTTP to the runtime PORT.
:{$PORT:8080} {
	bind 0.0.0.0
	root * /srv
	encode zstd gzip

	route {
		@backend path /api /api/* /oauth /oauth/* /sanctum /sanctum/*
		@turnstile {
			method POST
			path /api/auth/register /api/auth/login /api/auth/forgot-password /api/auth/verification/resend /api/contact /api/support/invoice /api/reports /oauth/google/role
		}
		header @turnstile >Cache-Control "no-store"
		reverse_proxy @backend {$API_UPSTREAM} {
			header_up Host {upstream_hostport}
			header_up X-Forwarded-For {client_ip}
		}

		# Serve existing assets directly and let Vue Router handle other paths.
		try_files {path} /index.html

		# Revalidate the entry point and PWA metadata after deployments.
		@revalidate path /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @revalidate Cache-Control "no-cache"
		file_server
	}
}
