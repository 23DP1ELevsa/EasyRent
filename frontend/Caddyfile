{
	admin off
	auto_https off
	persist_config off
}

# Railway terminates HTTPS and forwards HTTP to the runtime PORT.
:{$PORT:8080} {
	bind 0.0.0.0
	root * /srv
	encode zstd gzip

	route {
		# Serve existing assets directly and let Vue Router handle other paths.
		try_files {path} /index.html

		# Revalidate the entry point and PWA metadata after deployments.
		@revalidate path /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @revalidate Cache-Control "no-cache"
		file_server
	}
}
